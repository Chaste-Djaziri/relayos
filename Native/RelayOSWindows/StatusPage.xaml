<Page x:Class="RelayOSWindows.StatusPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Padding="32"><StackPanel Spacing="20"><TextBlock x:Name="PageTitle" FontSize="32" FontWeight="SemiBold"/><TextBlock x:Name="PageDescription" FontSize="16" Opacity="0.75" TextWrapping="Wrap"/>
    <StackPanel x:Name="GeneralPanel" Spacing="16"><Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="20"><StackPanel Spacing="12"><TextBlock Text="Public MCP endpoint" FontWeight="SemiBold"/><TextBlock x:Name="Endpoint" FontSize="18" IsTextSelectionEnabled="True"/><TextBlock Text="The endpoint is protected by local approval and OAuth." Opacity="0.7" TextWrapping="Wrap"/></StackPanel></Border><InfoBar IsOpen="True" Severity="Informational" Message="Native Windows companion is connected to the local RelayOS control service."/></StackPanel>
    <StackPanel x:Name="ConnectionsPanel" Visibility="Collapsed" Spacing="16"><TextBlock Text="Connected AI clients" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionsText" TextWrapping="Wrap"/><Button Content="Refresh connections" Click="Refresh_Click"/></StackPanel>
    <StackPanel x:Name="ToolsPanel" Visibility="Collapsed" Spacing="16"><TextBlock Text="Tools &amp; permissions" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ToolsText" TextWrapping="Wrap"/><Button Content="Refresh permissions" Click="Refresh_Click"/></StackPanel>
    <StackPanel x:Name="NgrokPanel" Visibility="Collapsed" Spacing="16"><TextBlock Text="ngrok transport" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="NgrokText" TextWrapping="Wrap"/><Button Content="Reconnect ngrok" Click="Reconnect_Click"/></StackPanel>
    <StackPanel x:Name="SecurityPanel" Visibility="Collapsed" Spacing="16"><TextBlock Text="Security" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="SecurityText" TextWrapping="Wrap"/><Button Content="Emergency stop" Click="EmergencyStop_Click"/></StackPanel>
    <StackPanel x:Name="ActivityPanel" Visibility="Collapsed" Spacing="16"><TextBlock Text="Activity" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ActivityText" TextWrapping="Wrap"/><Button Content="Refresh activity" Click="Refresh_Click"/></StackPanel>
  </StackPanel></ScrollViewer>
</Page>
