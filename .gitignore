# Path: .gitignore
# Python environments and caches
.venv/
__pycache__/
.pytest_cache/
*.py[cod]
*.egg-info/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local configuration
.env
.env.*
!.env.example

# Build and packaging output
dist/
build/
.build/

# macOS metadata
.DS_Store
**/.DS_Store

# Editors and temporary files
*.swp
*.swo
*~
# Native Windows build output
Native/**/bin/
Native/**/obj/
